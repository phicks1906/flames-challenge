+function _spotlightGoldGradientV1325(ctx,x1,y1,x2,y2){
+  const g=ctx.createLinearGradient(x1,y1,x2,y2);
+  g.addColorStop(0,'#fff0a6');
+  g.addColorStop(.28,'#e7bd58');
+  g.addColorStop(.60,'#b97b18');
+  g.addColorStop(.83,'#f2cc68');
+  g.addColorStop(1,'#fff6c4');
+  return g;
+}
+function _spotlightCrownUrlV1325(){
+  try{
