+<script id="fc-v1306-feed-motion-vote-dismiss-js">
+(function(){
+  'use strict';
+  const PREFIX='fcVoteNoticeDismissedV1306:';
+
+  function voteToken(v){
+    if(v==null)return 'none';
+    if(typeof v==='string'||typeof v==='number')return String(v);
+    return String(v.entry_id||v.entryId||v.id||v.vote_id||'recorded');
+  }
+  function dismissKey(surface,ch,v){
+    return `${PREFIX}${surface}:${String(ch?.id||'unknown')}:${voteToken(v)}`;
+  }
+  function wasDismissed(surface,ch,v){
+    try{return sessionStorage.getItem(dismissKey(surface,ch,v))==='1'}catch(_){return false}
+  }
+  function rememberDismissed(surface,ch,v){
+    try{sessionStorage.setItem(dismissKey(surface,ch,v),'1')}catch(_){}
+  }
+  function decorateRecordedNotice(el,ch,v,surface){
+    if(!el)return;
+    el.querySelector('.fc-vote-dismiss-v1306')?.remove();
+    if(!v)return;
+
+    if(wasDismissed(surface,ch,v)){
+      el.style.display='none';
+      return;
+    }
+    if(el.style.display==='none')return;
+
+    const btn=document.createElement('button');
+    btn.type='button';
+    btn.className='fc-vote-dismiss-v1306';
+    btn.setAttribute('aria-label','Dismiss vote recorded notice');
+    btn.textContent='×';
+    btn.addEventListener('click',event=>{
+      event.preventDefault();
+      event.stopPropagation();
+      rememberDismissed(surface,ch,v);
+      el.style.display='none';
+    });
+    el.appendChild(btn);
+  }
+
+  const priorCd=window.renderChallengeVotingNoticeV1024;
+  if(typeof priorCd==='function'){
+    window.renderChallengeVotingNoticeV1024=function(ch,status){
+      const result=priorCd.apply(this,arguments);
+      decorateRecordedNotice(document.getElementById('cdVotingNotice'),ch,state?.myCurrentVote,'detail');
+      return result;
+    };
+  }
+
+  const priorFv=window.renderFvVotingNoticeV1024;
+  if(typeof priorFv==='function'){
+    window.renderFvVotingNoticeV1024=function(ch,status,myVote,total){
+      const result=priorFv.apply(this,arguments);
+      decorateRecordedNotice(document.getElementById('fvVotingNotice'),ch,myVote,'viewer');
+      return result;
+    };
+  }
+
+  requestAnimationFrame(()=>{
+    const ch=state?.currentChallenge||window._fvChallenge||null;
+    if(ch){
+      decorateRecordedNotice(document.getElementById('cdVotingNotice'),ch,state?.myCurrentVote,'detail');
+    }
+  });
+
+  window.FC_V1306_VALIDATION={
+    build:'v1306',
+    feedCardWidth:'84%',
+    obviousPhysicalChallengerTravel:true,
+    nativeHorizontalSwipePreserved:true,
+    recordedVoteNoticeDismissible:true,
+    dismissalScopedToChallengeAndVote:true,
+    challengeDetailDismissSupported:true,
+    feedViewerDismissSupported:true,
+    v1305StandardFramesPreserved:true,
+    v1304CompletedChallengePreserved:true,
+    v1303FeedPopoutPreserved:true
+  };
+})();
+</script>
+
