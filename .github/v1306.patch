+<style id="fc-v1306-feed-motion-vote-dismiss-css">
+/* v1306 — make Challenger changes read as physical card travel on Home.
+   v1302's ~42px peek was still too subtle when adjacent entries used similar
+   artwork. Keep native horizontal scrolling, but expose enough of the next
+   frame that the outgoing and incoming cards are visibly distinct. */
+#feedContainer .fc-entry-rail-v1079 .fcc-entries-scroll{
+  gap:14px!important;
+  padding-left:16px!important;
+  padding-right:32px!important;
+  scroll-padding-left:16px!important;
+  scroll-snap-type:x mandatory!important;
+  overscroll-behavior-x:contain!important;
+}
+#feedContainer .fc-entry-rail-v1079 .fcc-entry-card{
+  flex:0 0 84%!important;
+  min-width:84%!important;
+  width:84%!important;
+  max-width:84%!important;
+  scroll-snap-align:start!important;
+  scroll-snap-stop:always!important;
+}
+#feedContainer .fc-entry-rail-v1079 .fcc-entries-scroll::after{
+  content:"";
+  flex:0 0 calc(16% + 18px)!important;
+  width:calc(16% + 18px)!important;
+}
+/* The card frame itself is the motion cue; do not animate the media independently. */
+#feedContainer .fc-entry-rail-v1079 .fcc-entry-card,
+#feedContainer .fc-entry-rail-v1079 .fcc-entry-media{
+  transition:none!important;
+}
+
+/* Recorded-vote notices can be dismissed so they do not occupy the top of the
+   challenge/feed viewer after the member already understands the state. */
+.fc-v1024-vote-notice.recorded{
+  position:relative!important;
+  padding-right:46px!important;
+}
+.fc-vote-dismiss-v1306{
+  position:absolute!important;
+  top:8px!important;
+  right:8px!important;
+  z-index:5!important;
+  width:30px!important;
+  height:30px!important;
+  min-width:30px!important;
+  padding:0!important;
+  margin:0!important;
+  display:grid!important;
+  place-items:center!important;
+  border-radius:50%!important;
+  border:1px solid rgba(255,255,255,.14)!important;
+  background:rgba(0,0,0,.24)!important;
+  color:var(--text-muted)!important;
+  font:700 20px/1 system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif!important;
+  cursor:pointer!important;
+  -webkit-tap-highlight-color:transparent!important;
+}
+.fc-vote-dismiss-v1306:active{
+  transform:scale(.94)!important;
+}
+body.theme-light .fc-vote-dismiss-v1306{
+  border-color:rgba(0,0,0,.14)!important;
+  background:rgba(255,255,255,.66)!important;
+  color:var(--text-muted)!important;
+}
+</style>
