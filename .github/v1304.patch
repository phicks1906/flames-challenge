+  border-bottom-color:rgba(255,205,102,.20)!important;
+}
+.fc-winner-head-v1304::after{
+  content:"";position:absolute;top:-40%;bottom:-40%;left:-34%;width:22%;pointer-events:none;opacity:.34;
+  background:linear-gradient(90deg,transparent,rgba(255,239,184,.42),transparent);
