+/* v1285 — horizontal entry viewers must size to the entry the member is
+   actually looking at. A flex row's cross-size is normally set by its tallest
+   child, so one portrait submission could leave hundreds of blank pixels under
+   a shorter landscape/video entry. Keep native horizontal scrolling, but make
+   the rail height follow the nearest snap page. */
+function fcResetFeedViewerActiveHeightV1285(list = document.getElementById('fvEntries')) {
+  if (!list) return;
+  if (list._fcHeightROV1285) {
+    try { list._fcHeightROV1285.disconnect(); } catch (_) {}
+    list._fcHeightROV1285 = null;
+  }
+  if (list._fcHeightScrollV1285) {
+    try { list.removeEventListener('scroll', list._fcHeightScrollV1285); } catch (_) {}
+    list._fcHeightScrollV1285 = null;
+  }
+  if (list._fcHeightRafV1285) {
+    try { cancelAnimationFrame(list._fcHeightRafV1285); } catch (_) {}
+    list._fcHeightRafV1285 = 0;
+  }
+  list.style.removeProperty('height');
+  list.removeAttribute('data-fc-active-height-v1285');
+  delete list.dataset.fcActiveIndexV1285;
+}
+
+function fcFeedViewerActiveIndexV1285(list) {
+  const slides = [...(list?.querySelectorAll('.fc-v1024-fv-slide') || [])];
+  if (!slides.length) return 0;
+  const width = Math.max(1, list.clientWidth || list.getBoundingClientRect().width || 1);
+  return Math.max(0, Math.min(slides.length - 1, Math.round(list.scrollLeft / width)));
+}
+
+function fcSyncFeedViewerActiveHeightV1285(list = document.getElementById('fvEntries')) {
+  if (!list || list.style.display === 'none') return;
+  const slides = [...list.querySelectorAll('.fc-v1024-fv-slide')];
+  if (!slides.length) {
+    list.style.removeProperty('height');
+    list.removeAttribute('data-fc-active-height-v1285');
+    return;
+  }
+  const index = fcFeedViewerActiveIndexV1285(list);
+  const slide = slides[index];
+  if (!slide) return;
+  const rectH = slide.getBoundingClientRect().height || 0;
+  const naturalH = Math.max(rectH, slide.scrollHeight || 0, slide.offsetHeight || 0);
+  if (!Number.isFinite(naturalH) || naturalH < 1) return;
+  const target = Math.ceil(naturalH);
+  const current = parseFloat(list.style.height || '0') || 0;
+  list.setAttribute('data-fc-active-height-v1285', '1');
+  list.dataset.fcActiveIndexV1285 = String(index);
+  if (Math.abs(current - target) > 1) list.style.height = target + 'px';
+  requestAnimationFrame(() => {
+    if (document.getElementById('feedViewerSheet')?.classList.contains('open')) {
+      fcPositionFeedViewerV1199();
+    }
+  });
+}
+
+function fcWireFeedViewerActiveHeightV1285(list = document.getElementById('fvEntries')) {
+  if (!list) return;
+  fcResetFeedViewerActiveHeightV1285(list);
+  const queue = () => {
+    if (list._fcHeightRafV1285) return;
+    list._fcHeightRafV1285 = requestAnimationFrame(() => {
+      list._fcHeightRafV1285 = 0;
+      fcSyncFeedViewerActiveHeightV1285(list);
+    });
+  };
+  list._fcHeightScrollV1285 = queue;
+  list.addEventListener('scroll', queue, { passive:true });
+  if (typeof ResizeObserver === 'function') {
+    const ro = new ResizeObserver(queue);
+    list.querySelectorAll('.fc-v1024-fv-slide').forEach(slide => ro.observe(slide));
+    list._fcHeightROV1285 = ro;
+  }
+  requestAnimationFrame(queue);
+  setTimeout(queue, 80);
+  setTimeout(queue, 260);
+}
+
+
 
 
